<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="LookAway.App.Views.BreakOverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- Vollbild-Hintergrund in der Overlay-Farbe, darüber auf Wunsch ein eigenes Bild mit einer
         schwarzen Abdunklung. Farbe, Bild und Abdunklung setzt der Code-Behind aus den
         Einstellungen; der Pinsel hier trägt nur so lange, bis das geschehen ist. Die Farbe
         bleibt unter dem Bild liegen: Sie deckt den Monitor, bis das Bild gezeichnet ist, und
         falls es sich nicht laden lässt.

         KeyboardAcceleratorPlacementMode="Hidden": Ein Element mit Tastenkürzel blendet sonst
         die Taste als Tooltip ein, sobald der Zeiger darüber ruht. Das Raster deckt den ganzen
         Bildschirm, also stünde „Esc" überall dort, wo die Maus stehen bleibt. Die Taste nennt
         der Endhinweis auf dem Hauptmonitor ohnehin. -->
    <Grid
        x:Name="RootGrid"
        Background="{ThemeResource RcOverlayBackground}"
        KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Escape" Invoked="OnEscapeInvoked" />
        </Grid.KeyboardAccelerators>

        <Border x:Name="ImageLayer" Visibility="Collapsed" />
        <Border x:Name="DimLayer" Background="{ThemeResource RcOverlayImageDim}" Visibility="Collapsed" />

        <StackPanel
            x:Name="ContentPanel"
            VerticalAlignment="Center"
            HorizontalAlignment="Center"
            MaxWidth="960"
            Spacing="20">

            <TextBlock
                x:Name="TitleText"
                Style="{StaticResource RcOverlayTitleStyle}"
                AutomationProperties.LiveSetting="Assertive" />

            <TextBlock
                x:Name="HintText"
                Style="{StaticResource RcOverlayHintStyle}" />

            <TextBlock
                x:Name="CountdownText"
                Style="{StaticResource RcOverlayCountdownStyle}" />

            <TextBlock
                x:Name="EndHintText"
                Style="{StaticResource RcOverlayEndHintStyle}"
                Margin="0,24,0,0" />
        </StackPanel>
    </Grid>
</Window>
