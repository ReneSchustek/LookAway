<?xml version="1.0" encoding="utf-8"?>
<!--
    Bausteine der Gestaltungslinie: Textstile, Schaltflächen, Karten, Filter-Chips.

    Farben stehen hier ausschließlich als ThemeResource — StaticResource würde den
    Wert beim Laden einfrieren und die Stelle beim Wechsel des Erscheinungsbilds
    stehen lassen. Maße und Radien dagegen als StaticResource: Sie ändern sich zur
    Laufzeit nie.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ══ Text ══════════════════════════════════════════════════════════════
         Der implizite Stil setzt bewusst keine Textfarbe. Ein pauschaler
         Vordergrund für alle Textblöcke schlägt die Vererbung und färbt genau
         die Beschriftungen um, die absichtlich auf einer Primärfläche stehen.
         Die Farbe kommt daher entweder aus dem Rahmenwerk (Standardfall, in
         beiden Belegungen gesetzt) oder aus einem der benannten Stile. -->
    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource RcFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource RcFontSizeBody}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="RcH1TextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource RcFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource RcFontSizeH1}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{ThemeResource RcText}" />
    </Style>

    <Style x:Key="RcH2TextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource RcFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource RcFontSizeH2}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{ThemeResource RcText}" />
    </Style>

    <Style x:Key="RcH3TextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource RcFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource RcFontSizeH3}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{ThemeResource RcText}" />
    </Style>

    <Style x:Key="RcBodyTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource RcFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource RcFontSizeBody}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{ThemeResource RcText}" />
    </Style>

    <Style x:Key="RcMutedTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource RcFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource RcFontSizeCaption}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{ThemeResource RcTextMuted}" />
    </Style>

    <Style x:Key="RcCaptionTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource RcFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource RcFontSizeCaption}" />
        <Setter Property="Foreground" Value="{ThemeResource RcText}" />
    </Style>

    <!-- Text auf einer Primärfläche. Eigener Stil, weil die Farbe mit der
         Belegung kippt — im Hellen weiß auf Petrol, im Dunklen dunkel auf
         Stahlgrau. -->
    <Style x:Key="RcOnPrimaryTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource RcFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource RcFontSizeBody}" />
        <Setter Property="Foreground" Value="{ThemeResource RcOnPrimary}" />
    </Style>

    <!-- Abschnittsbeschriftung: klein, gesperrt, gedämpft. Das auffälligste
         Merkmal der Linie — es ersetzt große Zwischenüberschriften. Den Text
         in Großbuchstaben liefert der UpperCaseConverter, damit die
         Sprachdateien ihre normale Schreibweise behalten. -->
    <Style x:Key="RcSectionLabelStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource RcFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource RcFontSizeCaption}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="CharacterSpacing" Value="80" />
        <Setter Property="Foreground" Value="{ThemeResource RcTextMuted}" />
        <Setter Property="Margin" Value="2,0,0,4" />
    </Style>

    <!-- ══ Protokoll-Stufen ══════════════════════════════════════════════════
         Die Stufe steht als Wort in der Liste, nicht nur als Farbe: Ein Zustand,
         den allein die Farbe trägt, ist für einen Teil der Benutzer gar nicht da.
         Die Farbe kommt dazu, sie ersetzt das Wort nicht. -->
    <Style x:Key="RcLogLevelInformationStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource RcFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource RcFontSizeCaption}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{ThemeResource RcStatusNeutralForeground}" />
    </Style>

    <Style x:Key="RcLogLevelWarningStyle" TargetType="TextBlock" BasedOn="{StaticResource RcLogLevelInformationStyle}">
        <Setter Property="Foreground" Value="{ThemeResource RcStatusWarningForeground}" />
    </Style>

    <Style x:Key="RcLogLevelErrorStyle" TargetType="TextBlock" BasedOn="{StaticResource RcLogLevelInformationStyle}">
        <Setter Property="Foreground" Value="{ThemeResource RcStatusErrorForeground}" />
    </Style>

    <!-- Abzeichen auf der Kachel des verwendeten Pausenmodells. -->
    <Style x:Key="RcBadgeStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource RcPrimarySoft}" />
        <Setter Property="BorderBrush" Value="{ThemeResource RcBorder}" />
        <Setter Property="BorderThickness" Value="{StaticResource RcHairlineThickness}" />
        <Setter Property="CornerRadius" Value="{StaticResource RcChipCornerRadius}" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ══ Pausen-Overlay ════════════════════════════════════════════════════
         Eigene Stile, weil das Overlay auf einer vom Nutzer gewählten Fläche
         steht und deshalb nicht der Textfarbe der Fenster folgt. -->
    <Style x:Key="RcOverlayTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource RcFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource RcFontSizeOverlayTitle}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{ThemeResource RcOverlayForeground}" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <Style x:Key="RcOverlayHintStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource RcFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource RcFontSizeOverlayHint}" />
        <Setter Property="Foreground" Value="{ThemeResource RcOverlayForegroundMuted}" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <Style x:Key="RcOverlayCountdownStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource RcFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource RcFontSizeOverlayCountdown}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{ThemeResource RcOverlayForeground}" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <Style x:Key="RcOverlayEndHintStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource RcFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource RcFontSizeBody}" />
        <Setter Property="Foreground" Value="{ThemeResource RcOverlayForegroundFaint}" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <!-- ══ Seitenkopf ════════════════════════════════════════════════════════ -->
    <Style x:Key="RcPageTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource RcH2TextStyle}" />

    <Style x:Key="RcPageSubtitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource RcFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource RcFontSizeBody}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{ThemeResource RcTextMuted}" />
    </Style>

    <!-- ══ Schaltflächen ═════════════════════════════════════════════════════
         Zweitrangige Aktionen tragen einen Umriss statt einer Fläche, damit auf
         einer Seite klar bleibt, welche Aktion die vorgesehene ist. -->
    <Style x:Key="RcButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="FontFamily" Value="{StaticResource RcFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource RcFontSizeBody}" />
        <Setter Property="CornerRadius" Value="{StaticResource RcControlCornerRadius}" />
        <Setter Property="Padding" Value="{StaticResource RcControlPadding}" />
        <Setter Property="MinHeight" Value="{StaticResource RcRowHeight}" />
    </Style>

    <Style TargetType="Button" BasedOn="{StaticResource RcButtonStyle}" />

    <Style x:Key="RcPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource RcButtonStyle}">
        <Setter Property="Background" Value="{ThemeResource RcPrimary}" />
        <Setter Property="Foreground" Value="{ThemeResource RcOnPrimary}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- ══ Trennlinie ════════════════════════════════════════════════════════ -->
    <Style x:Key="RcDividerStyle" TargetType="Border">
        <Setter Property="BorderBrush" Value="{ThemeResource RcBorder}" />
        <Setter Property="BorderThickness" Value="{StaticResource RcTopHairlineThickness}" />
    </Style>

    <!-- ══ Karte ═════════════════════════════════════════════════════════════
         Flächen trennen sich über Farbe und Haarlinie, nicht über Tiefe —
         deshalb kein Schlagschatten. -->
    <Style x:Key="RcCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource RcCardBackground}" />
        <Setter Property="BorderBrush" Value="{ThemeResource RcCardBorder}" />
        <Setter Property="BorderThickness" Value="{StaticResource RcHairlineThickness}" />
        <Setter Property="CornerRadius" Value="{StaticResource RcCardCornerRadius}" />
        <Setter Property="Padding" Value="{StaticResource RcCardPadding}" />
    </Style>

    <!-- Anklickbare Kachel: Sie zeigt beim Überfahren einen Wechsel der
         Randfarbe, kein Anheben. Als Button und nicht als Border, damit sie
         mit der Tastatur erreichbar bleibt und einen sichtbaren Fokus hat. -->
    <Style x:Key="RcCardButtonStyle" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource RcFontFamily}" />
        <Setter Property="Background" Value="{ThemeResource RcCardBackground}" />
        <Setter Property="BorderBrush" Value="{ThemeResource RcCardBorder}" />
        <Setter Property="BorderThickness" Value="{StaticResource RcHairlineThickness}" />
        <Setter Property="CornerRadius" Value="{StaticResource RcCardCornerRadius}" />
        <Setter Property="Padding" Value="{StaticResource RcCardPadding}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="CardBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CardBorder" Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource RcCardBorderHover}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CardBorder" Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource RcCardBorderHover}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CardBorder" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource RcSurfaceRaised}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <ContentPresenter
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══ Filter-Chip ═══════════════════════════════════════════════════════
         Filter stehen als Chips zum Umschalten, nicht als Aufklappliste: Was
         gewählt ist, sieht man ohne zu klicken. Der gewählte Zustand ist nie
         allein über Farbe erkennbar — dafür steht das Häkchen davor. -->
    <Style x:Key="RcFilterChipStyle" TargetType="ToggleButton">
        <Setter Property="FontFamily" Value="{StaticResource RcFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource RcFontSizeCaption}" />
        <Setter Property="Background" Value="{ThemeResource RcSurface}" />
        <Setter Property="Foreground" Value="{ThemeResource RcText}" />
        <Setter Property="BorderBrush" Value="{ThemeResource RcInputBorder}" />
        <Setter Property="BorderThickness" Value="{StaticResource RcHairlineThickness}" />
        <Setter Property="CornerRadius" Value="{StaticResource RcChipCornerRadius}" />
        <Setter Property="Padding" Value="{StaticResource RcControlPadding}" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="ChipBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ChipBorder" Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource RcInputBorderHover}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed" />
                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ChipText" Storyboard.TargetProperty="Foreground">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource RcTextDisabled}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Checked">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ChipBorder" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource RcPrimary}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ChipBorder" Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource RcPrimary}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ChipText" Storyboard.TargetProperty="Foreground">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource RcOnPrimary}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ChipCheck" Storyboard.TargetProperty="Foreground">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource RcOnPrimary}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ChipCheck" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="Visible" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="CheckedPointerOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ChipBorder" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource RcPrimaryHover}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ChipBorder" Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource RcPrimaryHover}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ChipText" Storyboard.TargetProperty="Foreground">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource RcOnPrimary}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ChipCheck" Storyboard.TargetProperty="Foreground">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource RcOnPrimary}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ChipCheck" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="Visible" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="CheckedPressed">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ChipBorder" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource RcPrimaryPressed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ChipText" Storyboard.TargetProperty="Foreground">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource RcOnPrimary}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ChipCheck" Storyboard.TargetProperty="Foreground">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource RcOnPrimary}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ChipCheck" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="Visible" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="CheckedDisabled" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock x:Name="ChipCheck"
                                       Text="&#xE73E;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="{StaticResource RcIconSizeS}"
                                       VerticalAlignment="Center"
                                       Visibility="Collapsed"
                                       AutomationProperties.AccessibilityView="Raw" />
                            <TextBlock x:Name="ChipText"
                                       Text="{TemplateBinding Content}"
                                       FontFamily="{StaticResource RcFontFamily}"
                                       FontSize="{StaticResource RcFontSizeCaption}"
                                       Foreground="{TemplateBinding Foreground}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
