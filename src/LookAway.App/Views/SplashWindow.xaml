<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="LookAway.App.Views.SplashWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Startbild: Logo, Produktname, Version. Kein Rahmen, kein Titelbalken, keine Bedienung —
        es zeigt nur, dass LookAway startet, und schließt sich, sobald der Start durch ist.
    -->
    <Grid Background="{ThemeResource RcBackground}" CornerRadius="{StaticResource RcControlCornerRadius}">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
            <Image
                x:Name="LogoImage"
                Width="160"
                Height="160"
                Stretch="Uniform"
                AutomationProperties.AccessibilityView="Raw" />
            <TextBlock
                Text="LookAway"
                Style="{StaticResource RcH1TextStyle}"
                HorizontalAlignment="Center" />
            <TextBlock
                x:Name="VersionText"
                Style="{StaticResource RcCaptionTextStyle}"
                HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</Window>
