# ============================================================
# .gitignore – LookAway
# ============================================================
# Persoenliche Notizdateien sind in ~/.gitignore_global eingetragen
# und müssen hier NICHT wiederholt werden.
# ============================================================

# ============================================================
# Lokale Werkzeug-/Vorlagendateien (nicht versionieren)
# ============================================================

# ============================================================
# SCRIPTE nie committen — Ausnahme: tools/ liefert Repo-Skripte
# ============================================================
*.ps1
!tools/*.ps1

# ============================================================
# Test- und Coverage-Artefakte (CI legt diese unter test-results/ ab)
# ============================================================
test-results/
TestResults/
coverage/
*.trx
*.coverage
*.coveragexml

# ============================================================
# Hinweis: reviews/ gehört NICHT in .gitignore
# ============================================================
# reviews/ wird auf DevBox in Git versioniert (Entwicklungshistorie).
# GitHub-Export-Script schließt reviews/ automatisch aus.
# Niemals reviews/ hier eintragen.
# ============================================================

# ============================================================
# Secrets / Umgebungsvariablen (NIEMALS in Git!)
# ============================================================
.env
.env.local
.env.*.local
!.env.example
secrets.json
*.pfx
*.p12
*.key
config/secrets/

# ============================================================
# Logs
# ============================================================
*.log
/logs/

# ============================================================
# .NET / Visual Studio
# ============================================================
bin/
obj/
*.user
*.suo
*.userosscache
*.sln.docstates
.vs/
packages/
*.nupkg
project.lock.json
*.nuget.props
*.nuget.targets

# Build-Ergebnisse
[Dd]ebug/
[Rr]elease/
x64/
x86/
ARM64/
[Bb]uild/
bld/

# Publish
publish/

# NuGet
**/[Pp]ackages/*
!**/[Pp]ackages/build/

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Rider
.idea/

# Lokale Hilfs-/Arbeitsverzeichnisse (nicht versionieren)

# MSIX-Build-Artefakte
**/AppPackages/

# Verteil-Artefakte (publish.ps1)
/dist/

# Portable Werkzeuge werden nicht versioniert (lokal via tools/install-*.ps1 holen)
*.exe


# Generiertes Setup-Icon (via installer/make-setup-icon.ps1)
installer/setup-icon.ico

# Private Signaturschlüssel dürfen NIE ins Repo (Release-Signierung).
# Der öffentliche Schlüssel ist in ReleaseSignatureVerifier eingebettet; der
# private bleibt offline. Detached-Signaturen (*.sig) sind Release-Artefakte.
*.pem
*.sig
*signing-key*

# Lokales Entwickler-Werkzeug (nicht Bestandteil des Repos)
tools/install-pre-commit-hook.ps1

# Lokale Ausnahmeliste eines Entwickler-Werkzeugs (nicht Bestandteil des Repos)
.ai-trace-ignore

# Die globale Ignorierliste dieses Rechners schließt "docs/" aus. Hier ist das
# Projektdokumentation samt Screenshots und gehört ins Repository.
!docs/
!docs/**
