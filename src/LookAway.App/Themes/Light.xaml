<?xml version="1.0" encoding="utf-8"?>
<!--
    Helle Belegung der Gestaltungslinie.

    Die Farbwerte stammen aus der Marke und nicht aus diesem Projekt — wer sie
    ändert, ändert sie zuerst dort. Light.xaml und Dark.xaml führen denselben
    Satz Schlüssel und unterscheiden sich nur in den Werten. Nur so lässt sich
    das Erscheinungsbild zur Laufzeit tauschen, ohne dass eine Bindung ins Leere
    greift: Ein Schlüssel, der nur in einer Belegung steht, bricht die Ansicht
    genau in der anderen — und das fällt erst beim Nutzer auf. Wer hier einen
    Schlüssel ergänzt, ergänzt ihn auch in Dark.xaml.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ── Flächen ─────────────────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="RcBackground" Color="#F5F5F5" />
    <SolidColorBrush x:Key="RcSurface" Color="#FFFFFF" />
    <SolidColorBrush x:Key="RcSurfaceRaised" Color="#EBEBEB" />
    <SolidColorBrush x:Key="RcSurfaceHover" Color="#E4E4E4" />

    <!-- ── Text ────────────────────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="RcText" Color="#1A1A1A" />
    <SolidColorBrush x:Key="RcTextMuted" Color="#5A5A5A" />
    <SolidColorBrush x:Key="RcTextDisabled" Color="#B4B4B4" />

    <!--
        Text auf einer Primärfläche. Eigener Schlüssel, weil er mit der Belegung
        kippt: Im Hellen ist die Primärfläche dunkel und trägt weiße Schrift, im
        Dunklen ist sie hell und trägt dunkle. Ein gemeinsamer "Invers"-Wert für
        beide Fälle ergäbe dort Weiß auf Hellgrau.
    -->
    <SolidColorBrush x:Key="RcOnPrimary" Color="#FFFFFF" />

    <!-- ── Primärfarbe (Marke: Petrol) ─────────────────────────────────────── -->
    <SolidColorBrush x:Key="RcPrimary" Color="#2F4858" />
    <SolidColorBrush x:Key="RcPrimaryHover" Color="#3A5A6E" />
    <SolidColorBrush x:Key="RcPrimaryPressed" Color="#0D2B38" />
    <SolidColorBrush x:Key="RcPrimaryDisabled" Color="#A8B8C2" />
    <SolidColorBrush x:Key="RcPrimaryLight" Color="#2D7FA8" />
    <SolidColorBrush x:Key="RcPrimarySoft" Color="#E3EAEE" />

    <!-- ── Karten und Linien ───────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="RcCardBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="RcCardBorder" Color="#1A000000" />
    <SolidColorBrush x:Key="RcCardBorderHover" Color="#2F4858" />
    <SolidColorBrush x:Key="RcBorder" Color="#1A000000" />
    <SolidColorBrush x:Key="RcFocusVisual" Color="#2D7FA8" />

    <!-- ── Eingabefelder ───────────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="RcInputBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="RcInputBorder" Color="#DCDCDC" />
    <SolidColorBrush x:Key="RcInputBorderHover" Color="#A8A8A8" />
    <SolidColorBrush x:Key="RcInputBorderFocus" Color="#2F4858" />

    <!--
        ── Status ───────────────────────────────────────────────────────────────
        Vordergrund und Fläche sind getrennt, weil Text auf der Fläche lesbar
        bleiben muss; die Fläche allein trägt die Aussage nie — dafür stehen
        Wort und Zeichen. Gedeckt gehalten, damit sie neben dem Petrol der
        Marke nicht schreien.
    -->
    <SolidColorBrush x:Key="RcStatusNeutralForeground" Color="#5A5A5A" />
    <SolidColorBrush x:Key="RcStatusNeutralBackground" Color="#EBEBEB" />
    <SolidColorBrush x:Key="RcStatusNeutralBorder" Color="#DCDCDC" />

    <SolidColorBrush x:Key="RcStatusSuccessForeground" Color="#2C6B3F" />
    <SolidColorBrush x:Key="RcStatusSuccessBackground" Color="#E1EFE4" />
    <SolidColorBrush x:Key="RcStatusSuccessBorder" Color="#A9CDB4" />

    <SolidColorBrush x:Key="RcStatusWarningForeground" Color="#8A5A17" />
    <SolidColorBrush x:Key="RcStatusWarningBackground" Color="#F6EDDD" />
    <SolidColorBrush x:Key="RcStatusWarningBorder" Color="#E0C48D" />

    <SolidColorBrush x:Key="RcStatusErrorForeground" Color="#96332F" />
    <SolidColorBrush x:Key="RcStatusErrorBackground" Color="#F5E3E3" />
    <SolidColorBrush x:Key="RcStatusErrorBorder" Color="#DFAFAD" />

    <!--
        ── Pausen-Overlay ───────────────────────────────────────────────────────
        Die Fläche der Pause färbt der Nutzer selbst (Einstellungen), sie ist
        also keine Fläche der Anwendung. Ihre Schrift trägt deshalb in beiden
        Belegungen denselben hellen Wert: Sie muss zur gewählten Farbe passen,
        nicht zum Erscheinungsbild der Fenster. Der Rückfallwert greift nur,
        solange der Code die gespeicherte Farbe noch nicht gesetzt hat.
    -->
    <SolidColorBrush x:Key="RcOverlayBackground" Color="#0F1115" />
    <SolidColorBrush x:Key="RcOverlayForeground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="RcOverlayForegroundMuted" Color="#E5E7EB" />
    <SolidColorBrush x:Key="RcOverlayForegroundFaint" Color="#9CA3AF" />

    <!--
        Zweiter Satz für helle Overlay-Farben. Welcher der beiden greift, entscheidet
        das Kontrastverhältnis zur gewählten Farbe, nicht das Erscheinungsbild der
        Fenster — deshalb stehen beide Sätze in beiden Belegungen mit denselben Werten.
    -->
    <SolidColorBrush x:Key="RcOverlayForegroundOnLight" Color="#0B1F1C" />
    <SolidColorBrush x:Key="RcOverlayForegroundMutedOnLight" Color="#334A45" />
    <SolidColorBrush x:Key="RcOverlayForegroundFaintOnLight" Color="#52706A" />

    <!--
        ── WinUI-Systempinsel ───────────────────────────────────────────────────
        Standard-Steuerelemente (Seitenmenü, Auswahlfelder, Schieberegler)
        zeichnen sich aus den Pinseln des Rahmenwerks. Ohne diese Belegung
        stünde neben der Marke die Voreinstellung von Windows.
    -->
    <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="#F5F5F5" />
    <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="NavigationViewContentBackground" Color="#F5F5F5" />
    <SolidColorBrush x:Key="NavigationViewItemForeground" Color="#1A1A1A" />
    <SolidColorBrush x:Key="NavigationViewItemForegroundPointerOver" Color="#1A1A1A" />
    <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="#2F4858" />
    <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPointerOver" Color="#2F4858" />
    <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPressed" Color="#2F4858" />
    <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="#EBEBEB" />
    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#E3EAEE" />
    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="#D6E1E7" />
    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPressed" Color="#D6E1E7" />
    <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="#2F4858" />

    <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#F5F5F5" />
    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#FAFAFA" />
    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#EBEBEB" />

    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#2F4858" />
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#3A5A6E" />
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#0D2B38" />
    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#E3EAEE" />

    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#1A1A1A" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#5A5A5A" />
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#767676" />

    <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#1A000000" />
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#1A000000" />
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#DCDCDC" />

    <!--
        ── Akzentfarbe des Rahmenwerks ──────────────────────────────────────────
        Ohne diese Werte ziehen Kontrollkästchen, Schieberegler, Verweise und der
        Auswahlstrich der Seitenleiste die in Windows eingestellte Akzentfarbe —
        auf einem Rechner also Orange, auf dem nächsten Grün. Die Marke wäre dann
        genau an den Stellen weg, die der Benutzer anfasst. Die Farben stehen als
        Color und nicht nur als Pinsel, weil das Rahmenwerk weitere Abstufungen
        daraus ableitet.
    -->
    <Color x:Key="SystemAccentColor">#2F4858</Color>
    <Color x:Key="SystemAccentColorLight1">#3A5A6E</Color>
    <Color x:Key="SystemAccentColorLight2">#4A6B80</Color>
    <Color x:Key="SystemAccentColorLight3">#5C7D93</Color>
    <Color x:Key="SystemAccentColorDark1">#263B47</Color>
    <Color x:Key="SystemAccentColorDark2">#1D2E38</Color>
    <Color x:Key="SystemAccentColorDark3">#0D2B38</Color>

    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="#2F4858" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="#3A5A6E" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed" Color="#0D2B38" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeChecked" Color="#2F4858" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPointerOver" Color="#3A5A6E" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPressed" Color="#0D2B38" />
    <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPressed" Color="#FFFFFF" />

    <SolidColorBrush x:Key="HyperlinkButtonForeground" Color="#2F4858" />
    <SolidColorBrush x:Key="HyperlinkButtonForegroundPointerOver" Color="#2D7FA8" />
    <SolidColorBrush x:Key="HyperlinkButtonForegroundPressed" Color="#0D2B38" />

    <SolidColorBrush x:Key="SliderTrackValueFill" Color="#2F4858" />
    <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#3A5A6E" />
    <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#0D2B38" />
    <SolidColorBrush x:Key="SliderThumbBackground" Color="#2F4858" />
    <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#3A5A6E" />
    <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#0D2B38" />

    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#2F4858" />
    <SolidColorBrush x:Key="TextControlSelectionHighlightColor" Color="#2F4858" />
    <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="#E3EAEE" />
    <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPointerOver" Color="#D6E1E7" />

</ResourceDictionary>
