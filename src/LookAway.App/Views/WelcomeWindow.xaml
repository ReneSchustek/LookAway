<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="LookAway.App.Views.WelcomeWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:LookAway.App.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" Padding="{StaticResource RcPagePadding}" RowSpacing="16" Background="{ThemeResource RcBackground}">
        <Grid.Resources>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding Title}" Style="{StaticResource RcH1TextStyle}" />

        <TextBlock Grid.Row="1" Text="{Binding Intro}" Style="{StaticResource RcBodyTextStyle}" />

        <!-- Schritt-Inhalt -->
        <Grid Grid.Row="2" VerticalAlignment="Top" Margin="0,12,0,0">
            <StackPanel
                Spacing="12"
                Visibility="{Binding IsStepLanguage, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding StepHeader}" Style="{StaticResource RcH3TextStyle}" />
                <ComboBox
                    Header="{Binding LanguageLabel}"
                    ItemsSource="{Binding Languages}"
                    SelectedItem="{Binding SelectedLanguageOption, Mode=TwoWay}"
                    DisplayMemberPath="Label"
                    MinWidth="280" />
            </StackPanel>

            <StackPanel
                Spacing="12"
                Visibility="{Binding IsStepModel, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding StepHeader}" Style="{StaticResource RcH3TextStyle}" />
                <ComboBox
                    Header="{Binding ModelLabel}"
                    ItemsSource="{Binding Models}"
                    SelectedItem="{Binding SelectedModelOption, Mode=TwoWay}"
                    DisplayMemberPath="Label"
                    MinWidth="360" />
            </StackPanel>

            <StackPanel
                Spacing="12"
                Visibility="{Binding IsStepAutoStart, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding StepHeader}" Style="{StaticResource RcH3TextStyle}" />
                <CheckBox Content="{Binding AutoStartLabel}" IsChecked="{Binding AutoStart, Mode=TwoWay}" />
                <TextBlock Text="{Binding AutoStartHint}" Style="{StaticResource RcMutedTextStyle}" />
            </StackPanel>
        </Grid>

        <TextBlock
            Grid.Row="3"
            Text="{Binding CloseHint}"
            Style="{StaticResource RcMutedTextStyle}" />

        <Grid Grid.Row="4">
            <TextBlock
                Text="{Binding StepProgress}"
                Style="{StaticResource RcMutedTextStyle}"
                VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
                <Button
                    Content="{Binding BackLabel}"
                    Command="{Binding BackCommand}"
                    Visibility="{Binding ShowBackButton, Converter={StaticResource BoolToVisibility}}" />
                <Button
                    Content="{Binding NextLabel}"
                    Command="{Binding NextCommand}"
                    Visibility="{Binding ShowNextButton, Converter={StaticResource BoolToVisibility}}" />
                <Button
                    Content="{Binding FinishLabel}"
                    Command="{Binding FinishCommand}"
                    Style="{StaticResource RcPrimaryButtonStyle}"
                    Visibility="{Binding ShowFinishButton, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
