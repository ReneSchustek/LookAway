<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         LookAway-Farbpalette "Teal" — hell, modern und augenfreundlich.
         Basiert auf einer ausgewogenen Teal-/Smaragd-Skala mit klar
         sichtbarem Akzent und WCAG-tauglichen Kontrasten. Teal wirkt
         ruhig und passt zur Augen-Pausen-App. Die Rc*-Pinsel speisen die
         eigenen Styles; die WinUI-System-Pinsel in den ThemeDictionaries
         färben Standard-Steuerelemente und das Seitenmenü ein.
         ============================================================ -->

    <!-- Eigene (theme-unabhängige) Pinsel für die App-Styles. -->
    <SolidColorBrush x:Key="RcCanvas" Color="#FFEFF6F4" />
    <SolidColorBrush x:Key="RcBackground" Color="#FFF4FAF8" />
    <SolidColorBrush x:Key="RcPaneBackground" Color="#FFE3F2EE" />
    <SolidColorBrush x:Key="RcCardBackground" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="RcAccent" Color="#FF0F766E" />
    <SolidColorBrush x:Key="RcAccentHover" Color="#FF0D9488" />
    <SolidColorBrush x:Key="RcAccentPressed" Color="#FF115E59" />
    <SolidColorBrush x:Key="RcAccentSoft" Color="#FFCCFBF1" />
    <SolidColorBrush x:Key="RcAccentForeground" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="RcTextPrimary" Color="#FF102A28" />
    <SolidColorBrush x:Key="RcTextSecondary" Color="#FF4B635E" />
    <SolidColorBrush x:Key="RcInteraction" Color="#FFE0F2EE" />
    <SolidColorBrush x:Key="RcDivider" Color="#FFD5E6E1" />
    <SolidColorBrush x:Key="RcError" Color="#FFDC2626" />

    <ResourceDictionary.ThemeDictionaries>

        <!-- LookAway erzwingt ein helles Erscheinungsbild: Light und Dark zeigen
             dieselbe Teal-Palette, damit die Optik unabhängig vom Windows-
             Systemmodus stabil bleibt. RequestedTheme=Light an den Fenster-Wurzeln
             stellt zusätzlich die hellen Control-Templates sicher. -->
        <ResourceDictionary x:Key="Light">
            <!-- Flächen / Hintergründe -->
            <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="#FFF4FAF8" />
            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#FFE3F2EE" />
            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="#FFE3F2EE" />
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="#FFF4FAF8" />
            <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#FFF4FAF8" />
            <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#FFF1F8F6" />
            <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#FFE8F3F0" />

            <!-- Seitenmenü: deutlich sichtbarer Auswahl- und Hover-Zustand -->
            <SolidColorBrush x:Key="NavigationViewItemForeground" Color="#FF102A28" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundPointerOver" Color="#FF102A28" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="#FF0F766E" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPointerOver" Color="#FF0F766E" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPressed" Color="#FF0F766E" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="#FFD3EEE8" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#FFCCFBF1" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="#FFB6F3E6" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPressed" Color="#FFB6F3E6" />
            <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="#FF0F766E" />

            <!-- Akzent -->
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#FF0F766E" />
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#FF0D9488" />
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#FF115E59" />
            <SolidColorBrush x:Key="SystemAccentColorLight1" Color="#FF0D9488" />
            <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#FFEAFBF7" />

            <!-- Text -->
            <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#FF102A28" />
            <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#FF4B635E" />
            <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#FF5C726C" />

            <!-- Linien -->
            <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#FFD5E6E1" />
            <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#FFDDEDE8" />
            <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#FFC9DED8" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="#FFF4FAF8" />
            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#FFE3F2EE" />
            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="#FFE3F2EE" />
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="#FFF4FAF8" />
            <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#FFF4FAF8" />
            <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#FFF1F8F6" />
            <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#FFE8F3F0" />

            <SolidColorBrush x:Key="NavigationViewItemForeground" Color="#FF102A28" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundPointerOver" Color="#FF102A28" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="#FF0F766E" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPointerOver" Color="#FF0F766E" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPressed" Color="#FF0F766E" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="#FFD3EEE8" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#FFCCFBF1" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="#FFB6F3E6" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPressed" Color="#FFB6F3E6" />
            <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="#FF0F766E" />

            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#FF0F766E" />
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#FF0D9488" />
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#FF115E59" />
            <SolidColorBrush x:Key="SystemAccentColorLight1" Color="#FF0D9488" />
            <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#FFEAFBF7" />

            <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#FF102A28" />
            <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#FF4B635E" />
            <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#FF5C726C" />

            <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#FFD5E6E1" />
            <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#FFDDEDE8" />
            <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#FFC9DED8" />
        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>

</ResourceDictionary>
