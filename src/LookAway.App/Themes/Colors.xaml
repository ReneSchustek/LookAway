<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         LookAway-Farbpalette "Mint/Teal" — hell und augenfreundlich.
         Gruen steht fuer Entspannung/Augen-Pause und passt thematisch
         zur Software. Die Rc*-Pinsel speisen die eigenen Styles
         (Buttons, Trenner, Statistik-Balken); die WinUI-System-Pinsel
         in den ThemeDictionaries faerben Standard-Steuerelemente und
         das NavigationView-Seitenmenue ein.
         ============================================================ -->

    <!-- Eigene (theme-unabhaengige) Pinsel fuer die App-Styles. -->
    <SolidColorBrush x:Key="RcBackground" Color="#FFF6FBF9" />
    <SolidColorBrush x:Key="RcPaneBackground" Color="#FFECF5F1" />
    <SolidColorBrush x:Key="RcCardBackground" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="RcAccent" Color="#FF2B9E78" />
    <SolidColorBrush x:Key="RcAccentHover" Color="#FF34B98C" />
    <SolidColorBrush x:Key="RcAccentForeground" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="RcTextPrimary" Color="#FF14302A" />
    <SolidColorBrush x:Key="RcTextSecondary" Color="#FF5C7A6F" />
    <SolidColorBrush x:Key="RcInteraction" Color="#FFE3EFEA" />
    <SolidColorBrush x:Key="RcDivider" Color="#FFD8E6E0" />
    <SolidColorBrush x:Key="RcError" Color="#FFB00020" />

    <ResourceDictionary.ThemeDictionaries>

        <!-- LookAway erzwingt ein helles Erscheinungsbild: Light und Dark zeigen
             dieselbe Mint/Teal-Palette, damit die Optik unabhaengig vom
             Windows-Systemmodus stabil bleibt. RequestedTheme=Light an den
             Fenster-Wurzeln stellt zusaetzlich die hellen Control-Templates sicher. -->
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="#FFF6FBF9" />
            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#FFECF5F1" />
            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="#FFECF5F1" />
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="#FFF6FBF9" />
            <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="#FF2B9E78" />
            <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#FFECF5F1" />
            <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#FFECF5F1" />
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#FF2B9E78" />
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#FF34B98C" />
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#FF237E60" />
            <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#FF14302A" />
            <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#FF5C7A6F" />
            <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFFFF" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="#FFF6FBF9" />
            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#FFECF5F1" />
            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="#FFECF5F1" />
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="#FFF6FBF9" />
            <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="#FF2B9E78" />
            <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#FFECF5F1" />
            <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#FFECF5F1" />
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#FF2B9E78" />
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#FF34B98C" />
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#FF237E60" />
            <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#FF14302A" />
            <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#FF5C7A6F" />
            <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFFFF" />
        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>

</ResourceDictionary>
