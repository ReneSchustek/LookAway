<?xml version="1.0" encoding="utf-8"?>
<!--
    Theme-unabhängige Bausteine: Abstände, Radien, Typografie, Kantenstärken.

    Diese Werte gelten in Hell und Dunkel gleichermaßen — nur Farben wechseln mit
    der Belegung. Deshalb stehen sie hier und nicht in Light.xaml/Dark.xaml.
    In dieser Datei steht bewusst kein einziger Farbwert.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ── Abstände ──────────────────────────────────────────────────────────
         Eine Skala statt frei gewählter Zahlen: Gleiche Abstände sehen überall
         gleich aus, und eine Änderung wirkt an einer Stelle. Grundmaß 8 px. -->
    <x:Double x:Key="RcSpacingXs">4</x:Double>
    <x:Double x:Key="RcSpacingS">8</x:Double>
    <x:Double x:Key="RcSpacingM">16</x:Double>
    <x:Double x:Key="RcSpacingL">24</x:Double>
    <x:Double x:Key="RcSpacingXl">32</x:Double>

    <Thickness x:Key="RcPagePadding">32,28,32,16</Thickness>
    <Thickness x:Key="RcCardPadding">20</Thickness>
    <Thickness x:Key="RcControlPadding">12,8</Thickness>
    <Thickness x:Key="RcActionBarPadding">32,14</Thickness>

    <!-- ── Radien ────────────────────────────────────────────────────────────
         Klein halten: Die Marke ist Industrie, nicht Spielzeug. Keine weichen
         16-px-Radien der Dashboard-Mode. -->
    <CornerRadius x:Key="RcControlCornerRadius">4</CornerRadius>
    <CornerRadius x:Key="RcCardCornerRadius">6</CornerRadius>
    <CornerRadius x:Key="RcChipCornerRadius">4</CornerRadius>

    <!-- ── Kanten ────────────────────────────────────────────────────────────
         Flächen trennen sich über Farbe und Haarlinie, nicht über Schatten. -->
    <Thickness x:Key="RcHairlineThickness">1</Thickness>
    <Thickness x:Key="RcTopHairlineThickness">0,1,0,0</Thickness>

    <!-- ── Typografie ────────────────────────────────────────────────────────
         Roboto liegt als TTF unter Assets/Fonts/ im Paket (Regular, Medium,
         Bold) — Windows bringt die Schrift nicht mit, ohne Einbettung entschiede
         das Zielsystem über das Schriftbild. Die drei Dateien melden dieselbe
         typografische Familie, deshalb genügt eine Referenz; das Gewicht wählt
         der jeweilige Style. Die Angaben hinter dem Komma bleiben als Fallback
         stehen, falls die eingebettete Datei nicht geladen werden kann. -->
    <FontFamily x:Key="RcFontFamily">ms-appx:///Assets/Fonts/Roboto-Regular.ttf#Roboto, Segoe UI Variable Text, Segoe UI</FontFamily>

    <x:Double x:Key="RcFontSizeH1">28</x:Double>
    <x:Double x:Key="RcFontSizeH2">22</x:Double>
    <x:Double x:Key="RcFontSizeH3">18</x:Double>
    <x:Double x:Key="RcFontSizeBody">14</x:Double>
    <x:Double x:Key="RcFontSizeCaption">12</x:Double>

    <!-- Das Pausen-Overlay füllt den Bildschirm und wird aus einigen Metern
         Abstand gelesen — es baut auf einer eigenen, größeren Staffel auf. -->
    <x:Double x:Key="RcFontSizeOverlayTitle">40</x:Double>
    <x:Double x:Key="RcFontSizeOverlayHint">22</x:Double>
    <x:Double x:Key="RcFontSizeOverlayCountdown">76</x:Double>

    <!-- Abschnittsüberschriften stehen klein, in Großbuchstaben und gesperrt.
         Das ist das auffälligste Merkmal der Linie und ersetzt große
         Zwischenüberschriften. -->
    <x:Double x:Key="RcSectionLabelSpacing">1.2</x:Double>

    <!-- ── Maße ──────────────────────────────────────────────────────────────
         Zeilenhöhe und Symbolgrößen, damit Listen und Leisten überall gleich
         hoch bauen. -->
    <x:Double x:Key="RcRowHeight">36</x:Double>
    <x:Double x:Key="RcIconSizeS">14</x:Double>
    <x:Double x:Key="RcIconSizeM">18</x:Double>
    <x:Double x:Key="RcIconSizeL">32</x:Double>
    <x:Double x:Key="RcContentMaxWidth">760</x:Double>

</ResourceDictionary>
