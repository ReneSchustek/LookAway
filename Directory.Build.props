<Project>
  <!--
    Zentrale Build-Konfiguration für alle Projekte in dieser Solution.
    Einzelne .csproj-Dateien können diese Werte überschreiben.
  -->
  <PropertyGroup>
    <!-- Single Source of Truth für die Versionsnummer.
         Die CI kann diesen Wert beim Tag-Push überschreiben (-p:Version=…). -->
    <Version>1.3.0</Version>
    <!-- Neueste Sprachfeatures (partielle Properties, Collection Expressions, …) -->
    <LangVersion>latest</LangVersion>
    <!-- Nullability: Null-Reference-Warnungen als Fehler -->
    <Nullable>enable</Nullable>
    <!-- Moderne using-Direktiven automatisch -->
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Alle Warnungen sind Fehler -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <!-- Alle Analyzer-Regeln aktiv (Security, Performance, Reliability) -->
    <AnalysisMode>All</AnalysisMode>
    <!-- Code-Style in Build erzwingen -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- XML-Dokumentation generieren (für IntelliSense) -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- Build-Härtung: Reproduzierbarkeit und CI-Stempel. Deterministic stellt sicher,
       dass identischer Quelltext identische Bytes erzeugt; ContinuousIntegrationBuild
       hält maschinenspezifische Pfade aus den Symboldateien heraus. -->
  <PropertyGroup>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- Test-Projekte: Unterstriche in Testnamen sind Konvention, XML-Doku entfällt. -->
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
    <NoWarn>$(NoWarn);CA1707</NoWarn>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
</Project>
