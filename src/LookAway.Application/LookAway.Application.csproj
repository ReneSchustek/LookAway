<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\LookAway.Core\LookAway.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.5" />
    <!-- UI-agnostische MVVM-Bausteine (ObservableObject/RelayCommand) fuer die
         testbaren ViewModels der Application-Schicht. Keine WinUI-Abhaengigkeit. -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LookAway.Tests.Unit" />
  </ItemGroup>

  <PropertyGroup>
    <!-- net10.0-windows wegen Windows-spezifischer APIs (z. B.
         EventWaitHandle.OpenExisting im SingleInstanceLock). LookAway
         ist eine Windows-Desktop-Anwendung; Cross-Platform-Tauglichkeit
         der Application-Schicht ist nicht Ziel. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
