<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Basis-Button: Roboto, abgerundete Ecken. Baut auf dem WinUI-Default auf,
         damit die Standard-Visual-States (Hover/Pressed) erhalten bleiben. -->
    <Style x:Key="RcButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="FontFamily" Value="{StaticResource RcFontFamily}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="18,8" />
    </Style>

    <!-- Implizit: alle Buttons erben den Basis-Stil. -->
    <Style TargetType="Button" BasedOn="{StaticResource RcButtonStyle}" />

    <!-- Primaer-Aktion: voller Teal-Akzent (Speichern, Fertig, Pause starten). -->
    <Style x:Key="RcPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource RcButtonStyle}">
        <Setter Property="Background" Value="{StaticResource RcAccent}" />
        <Setter Property="Foreground" Value="{StaticResource RcAccentForeground}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- Dezente Trennlinie (1 px). -->
    <Style x:Key="RcDividerStyle" TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource RcDivider}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
    </Style>

    <!-- Karte: weisse Flaeche mit feinem Rahmen und abgerundeten Ecken fuer eine
         moderne, klar gegliederte Optik auf dem leicht getoenten Hintergrund. -->
    <Style x:Key="RcCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource RcCardBackground}" />
        <Setter Property="BorderBrush" Value="{StaticResource RcDivider}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="22" />
    </Style>

</ResourceDictionary>
