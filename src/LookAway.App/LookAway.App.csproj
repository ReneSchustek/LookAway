<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>LookAway.App</RootNamespace>
    <AssemblyName>LookAway</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Icon der EXE (Explorer, Taskleiste, Alt+Tab) im unpackaged-Betrieb. -->
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <PublishProfile>win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <Nullable>enable</Nullable>
    <!-- Standardmäßig unpackaged (Tray-App ohne MSIX-Registrierung): F5/Run und
         die portable Variante laufen ohne Deploy. Für ein MSIX-Paket explizit
         mit -p:WindowsPackageType=MSIX bauen. -->
    <WindowsPackageType Condition="'$(WindowsPackageType)' == ''">None</WindowsPackageType>
    <!-- Das Windows App SDK wird immer mitgeliefert, nicht systemweit erwartet — so wie
         die portable Variante ohnehin publiziert wird. Ohne das baut das SDK in den
         unpackaged-Build einen Modul-Initialisierer ein, der beim Laden der Assembly
         eine passende Runtime sucht und ohne Treffer einen modalen Dialog öffnet. Im
         Test-Host (kein Desktop) blockiert dieser Dialog den Prozess endlos. -->
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- MSIX-Tooling (und damit der Deploy-Zwang in Visual Studio, DEP1560) nur im
         Paket-Modus aktivieren. Muss nach WindowsPackageType ausgewertet werden. -->
    <EnableMsixTooling Condition="'$(WindowsPackageType)' != 'None'">true</EnableMsixTooling>
  </PropertyGroup>

  <!-- WinAppSDK-self-contained-Publish (verteilbares EXE/Setup ohne installierte
       Runtime) zieht die generierte Datei UndockedRegFreeWinRT-AutoInitializer.cs
       aus dem WindowsAppSDK-Paket herein, die CA5392 verletzt. Da das Fremd-/
       Generat-Code außerhalb unserer .editorconfig (NuGet-Cache) ist und nur in
       diesem Modus kompiliert wird, wird CA5392 ausschließlich hier unterdrückt;
       normale Builds bleiben streng. -->
  <PropertyGroup Condition="'$(WindowsAppSDKSelfContained)' == 'true'">
    <NoWarn>$(NoWarn);CA5392</NoWarn>
  </PropertyGroup>

  <!-- WinUI-3-Resource-Index (LookAway.pri) wird beim Build erzeugt, aber von
       'dotnet publish' (unpackaged) nicht mitgenommen. Ohne PRI scheitert das
       Laden von XAML/ms-appx-Assets zur Laufzeit (XamlParseException). Daher die
       generierte PRI explizit in den Publish-Output aufnehmen. -->
  <Target Name="IncludeProjectPriInPublish" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <ResolvedFileToPublish Include="$(OutDir)$(AssemblyName).pri" Condition="Exists('$(OutDir)$(AssemblyName).pri')">
        <RelativePath>$(AssemblyName).pri</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

  <!-- Assets, die zur Laufzeit über echte Dateipfade geladen werden
       (AppWindow.SetIcon -> Assets\AppIcon.ico; H.NotifyIcon -> Assets\tray-*.ico;
       Sounds), liegen beim unpackaged-Publish sonst nur in der PRI und fehlen als
       lose Dateien -> DirectoryNotFoundException. Daher den Assets-Baum lose mit
       in den Publish-Output kopieren (wie im normalen Build). -->
  <Target Name="CopyLooseAssetsToPublish" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <_LooseAsset Include="$(MSBuildProjectDirectory)\Assets\**\*" />
      <ResolvedFileToPublish Include="@(_LooseAsset)">
        <RelativePath>Assets\%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

  <ItemGroup>
    <Content Include="Assets\SplashScreen.scale-200.png" />
    <Content Include="Assets\LockScreenLogo.scale-200.png" />
    <Content Include="Assets\Square150x150Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" />
    <Content Include="Assets\StoreLogo.png" />
    <Content Include="Assets\AppIcon.ico" />
    <Content Include="Assets\Wide310x150Logo.scale-200.png" />
    <Content Include="Assets\LookAwayLogo.png" />
    <Content Include="Assets\tray-working.ico" />
    <Content Include="Assets\tray-onbreak.ico" />
    <Content Include="Assets\tray-paused.ico" />
    <Content Include="Assets\tray-disabled.ico" />
    <Content Include="Assets\Sounds\chime.wav" />
    <Content Include="Assets\Sounds\bell.wav" />
    <Content Include="Assets\Sounds\pop.wav" />
    <!-- Roboto in drei Schnitten. Ohne die Dateien im Paket hängt das Schriftbild
         davon ab, ob auf dem Zielsystem zufällig eine Roboto installiert ist;
         Windows liefert keine mit. LICENSE.txt ist Pflicht (Apache-2.0). -->
    <Content Include="Assets\Fonts\Roboto-Regular.ttf" />
    <Content Include="Assets\Fonts\Roboto-Medium.ttf" />
    <Content Include="Assets\Fonts\Roboto-Bold.ttf" />
    <Content Include="Assets\Fonts\LICENSE.txt" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!--
    Defining the "Msix" ProjectCapability here allows the Single-project MSIX Packaging
    Tools extension to be activated for this project even if the Windows App SDK Nuget
    package has not yet been restored.
  -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.4.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.5" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.5" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.5" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2270" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LookAway.Core\LookAway.Core.csproj" />
    <ProjectReference Include="..\LookAway.Data\LookAway.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LookAway.App.Tests" />
  </ItemGroup>

  <!--
    Defining the "HasPackageAndPublishMenuAddedByProject" property here allows the Solution
    Explorer "Package and Publish" context menu entry to be enabled for this project even if
    the Windows App SDK Nuget package has not yet been restored.
  -->
  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <!-- Publish Properties -->
  <!-- Trimming und ReadyToRun sind mit WinUI 3 + .NET 10 noch nicht kompatibel.
       Wird (Installer) ggf. wieder aktiviert. -->
  <PropertyGroup>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
</Project>