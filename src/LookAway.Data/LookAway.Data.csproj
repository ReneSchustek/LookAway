<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\LookAway.Core\LookAway.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LookAway.Data.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Sprachtabellen werden ins Assembly eingebettet und zur Laufzeit über
         den Manifest-Ressourcennamen geladen (JsonLocalizationService). -->
    <EmbeddedResource Include="Localization\de.json" />
    <EmbeddedResource Include="Localization\en.json" />
    <EmbeddedResource Include="Localization\fr.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <!-- SystemEvents.PowerModeChanged ist Windows-spezifisch und benötigt
         dieses Paket; der TFM 'net10.0-windows' macht den Zugriff legitim. -->
    <PackageReference Include="Microsoft.Win32.SystemEvents" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Windows-SDK-TFM: liefert die WinRT-Projektionen (Windows.Media.Control für
         die SMTC-Mediensteuerung) und bündelt alle Windows-Adapter in dieser Schicht. -->
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- LibraryImport-Source-Generator (P/Invoke für Idle-/Vollbild-Erkennung)
         erzeugt unsafe-Marshalling-Code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

</Project>
