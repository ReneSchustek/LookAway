<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Muss den Windows-SDK-TFM der getesteten LookAway.Data-Schicht treffen
         (WinRT-Projektionen, Win32-Event-Anbindung, Registry). -->
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\LookAway.Core\LookAway.Core.csproj" />
    <ProjectReference Include="..\..\src\LookAway.Data\LookAway.Data.csproj" />
  </ItemGroup>

</Project>
