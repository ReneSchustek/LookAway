<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="LookAway.App.Views.BreakOverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- Abgedunkelter Vollbild-Hintergrund; helle Schrift für den Pausen-Inhalt.
         Die konkrete Hintergrundfarbe setzt der Code-Behind aus den Einstellungen,
         der Pinsel hier trägt nur so lange, bis das geschehen ist. -->
    <Grid x:Name="RootGrid" Background="{ThemeResource RcOverlayBackground}">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Escape" Invoked="OnEscapeInvoked" />
        </Grid.KeyboardAccelerators>

        <StackPanel
            x:Name="ContentPanel"
            VerticalAlignment="Center"
            HorizontalAlignment="Center"
            MaxWidth="960"
            Spacing="20">

            <TextBlock
                x:Name="TitleText"
                Style="{StaticResource RcOverlayTitleStyle}"
                AutomationProperties.LiveSetting="Assertive" />

            <TextBlock
                x:Name="HintText"
                Style="{StaticResource RcOverlayHintStyle}" />

            <TextBlock
                x:Name="CountdownText"
                Style="{StaticResource RcOverlayCountdownStyle}" />

            <TextBlock
                x:Name="EndHintText"
                Style="{StaticResource RcOverlayEndHintStyle}"
                Margin="0,24,0,0" />
        </StackPanel>
    </Grid>
</Window>
