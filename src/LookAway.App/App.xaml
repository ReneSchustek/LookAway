<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="LookAway.App.LookAwayApp"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LookAway.App">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Zwei Belegungen desselben Schlüsselsatzes. Das Rahmenwerk tauscht sie,
                 sobald das Erscheinungsbild wechselt; Ansichten binden mit ThemeResource
                 und gehen damit mit. -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light" Source="ms-appx:///Themes/Light.xaml" />
                <ResourceDictionary x:Key="Dark" Source="ms-appx:///Themes/Dark.xaml" />
            </ResourceDictionary.ThemeDictionaries>

            <!-- Reihenfolge zählt: Die Stile greifen auf die Tokens zu, die Tokens auf
                 nichts. -->
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="ms-appx:///Themes/Tokens.xaml" />
                <ResourceDictionary Source="ms-appx:///Themes/ControlStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
