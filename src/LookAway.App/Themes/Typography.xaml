<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Roboto liegt als TTF unter Assets/Fonts/ im Paket (Regular, Medium, Bold) —
        Windows bringt die Schrift nicht mit, ohne Einbettung entschiede das
        Zielsystem über das Schriftbild. Die drei Dateien melden dieselbe
        typografische Familie, deshalb genügt eine Referenz; das Gewicht wählt der
        jeweilige Style. Die Angaben hinter dem Komma bleiben als Fallback stehen,
        falls die eingebettete Datei nicht geladen werden kann.
    -->
    <FontFamily x:Key="RcFontFamily">ms-appx:///Assets/Fonts/Roboto-Regular.ttf#Roboto, Segoe UI Variable Text, Segoe UI</FontFamily>

    <!-- Schriftgrößen laut Designvorgabe. -->
    <x:Double x:Key="RcFontSizeH1">28</x:Double>
    <x:Double x:Key="RcFontSizeH2">22</x:Double>
    <x:Double x:Key="RcFontSizeH3">18</x:Double>
    <x:Double x:Key="RcFontSizeBody">14</x:Double>
    <x:Double x:Key="RcFontSizeCaption">12</x:Double>

    <!-- Standard-Textdarstellung. -->
    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource RcFontFamily}" />
        <Setter Property="Foreground" Value="{StaticResource RcTextPrimary}" />
        <Setter Property="FontSize" Value="{StaticResource RcFontSizeBody}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="RcH1TextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource RcFontFamily}" />
        <Setter Property="Foreground" Value="{StaticResource RcTextPrimary}" />
        <Setter Property="FontSize" Value="{StaticResource RcFontSizeH1}" />
        <Setter Property="FontWeight" Value="Medium" />
    </Style>

    <Style x:Key="RcH2TextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource RcFontFamily}" />
        <Setter Property="Foreground" Value="{StaticResource RcTextPrimary}" />
        <Setter Property="FontSize" Value="{StaticResource RcFontSizeH2}" />
        <Setter Property="FontWeight" Value="Medium" />
    </Style>

    <Style x:Key="RcH3TextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource RcFontFamily}" />
        <Setter Property="Foreground" Value="{StaticResource RcTextPrimary}" />
        <Setter Property="FontSize" Value="{StaticResource RcFontSizeH3}" />
        <Setter Property="FontWeight" Value="Medium" />
    </Style>

    <!-- Abschnittstitel oberhalb einer Karte. -->
    <Style x:Key="RcSectionHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource RcH2TextStyle}">
        <Setter Property="Margin" Value="2,0,0,4" />
    </Style>

    <!-- Sekundärer, dezenter Beschreibungstext. -->
    <Style x:Key="RcSecondaryTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource RcFontFamily}" />
        <Setter Property="Foreground" Value="{StaticResource RcTextSecondary}" />
        <Setter Property="FontSize" Value="{StaticResource RcFontSizeCaption}" />
    </Style>

    <Style x:Key="RcCaptionTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource RcFontFamily}" />
        <Setter Property="Foreground" Value="{StaticResource RcTextPrimary}" />
        <Setter Property="FontSize" Value="{StaticResource RcFontSizeCaption}" />
    </Style>

</ResourceDictionary>
