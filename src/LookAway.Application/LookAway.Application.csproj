<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\LookAway.Core\LookAway.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.5" />
    <!-- UI-agnostische MVVM-Bausteine (ObservableObject/RelayCommand) für die
         testbaren ViewModels der Application-Schicht. Keine WinUI-Abhängigkeit. -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LookAway.Tests.Unit" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Plattformneutral: die Application-Schicht spricht nur Core-Interfaces an;
         Windows-spezifische Adapter (SingleInstanceLock, Registry, P/Invoke, SMTC)
         liegen vollständig in der Data-Schicht. -->
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
