<?xml version="1.0" encoding="utf-8"?>
<!--
    Dunkle Belegung der Gestaltungslinie.

    Derselbe Schlüsselsatz wie Light.xaml, andere Werte — siehe die Begründung
    dort. Die Primärfarbe kippt hier vom dunklen Petrol auf ein helles Stahlgrau,
    und der Text auf ihr kippt mit: Die Primärfläche ist immer der Gegensatz zum
    Hintergrund. Deshalb trägt RcOnPrimary hier einen dunklen und dort einen
    hellen Wert.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ── Flächen ─────────────────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="RcBackground" Color="#0F1923" />
    <SolidColorBrush x:Key="RcSurface" Color="#152030" />
    <SolidColorBrush x:Key="RcSurfaceRaised" Color="#1A2535" />
    <SolidColorBrush x:Key="RcSurfaceHover" Color="#22303F" />

    <!-- ── Text ────────────────────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="RcText" Color="#E4EDF2" />
    <SolidColorBrush x:Key="RcTextMuted" Color="#8AA3B0" />
    <SolidColorBrush x:Key="RcTextDisabled" Color="#5B6B78" />

    <SolidColorBrush x:Key="RcOnPrimary" Color="#0F1923" />

    <!-- ── Primärfarbe (Marke: Stahlgrau) ──────────────────────────────────── -->
    <SolidColorBrush x:Key="RcPrimary" Color="#C5D0D6" />
    <SolidColorBrush x:Key="RcPrimaryHover" Color="#DDE5E9" />
    <SolidColorBrush x:Key="RcPrimaryPressed" Color="#94A3AB" />
    <SolidColorBrush x:Key="RcPrimaryDisabled" Color="#4A5A66" />
    <SolidColorBrush x:Key="RcPrimaryLight" Color="#DDE5E9" />
    <SolidColorBrush x:Key="RcPrimarySoft" Color="#22303F" />

    <!-- ── Karten und Linien ───────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="RcCardBackground" Color="#152030" />
    <SolidColorBrush x:Key="RcCardBorder" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="RcCardBorderHover" Color="#C5D0D6" />
    <SolidColorBrush x:Key="RcBorder" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="RcFocusVisual" Color="#DDE5E9" />

    <!-- ── Eingabefelder ───────────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="RcInputBackground" Color="#1A2535" />
    <SolidColorBrush x:Key="RcInputBorder" Color="#33424F" />
    <SolidColorBrush x:Key="RcInputBorderHover" Color="#5B6B78" />
    <SolidColorBrush x:Key="RcInputBorderFocus" Color="#C5D0D6" />

    <!-- ── Status ──────────────────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="RcStatusNeutralForeground" Color="#8AA3B0" />
    <SolidColorBrush x:Key="RcStatusNeutralBackground" Color="#1A2535" />
    <SolidColorBrush x:Key="RcStatusNeutralBorder" Color="#2A3849" />

    <SolidColorBrush x:Key="RcStatusSuccessForeground" Color="#8FCBA1" />
    <SolidColorBrush x:Key="RcStatusSuccessBackground" Color="#16281E" />
    <SolidColorBrush x:Key="RcStatusSuccessBorder" Color="#2F4A38" />

    <SolidColorBrush x:Key="RcStatusWarningForeground" Color="#E0BE85" />
    <SolidColorBrush x:Key="RcStatusWarningBackground" Color="#2A2318" />
    <SolidColorBrush x:Key="RcStatusWarningBorder" Color="#4A3F28" />

    <SolidColorBrush x:Key="RcStatusErrorForeground" Color="#E39C98" />
    <SolidColorBrush x:Key="RcStatusErrorBackground" Color="#2A1C1C" />
    <SolidColorBrush x:Key="RcStatusErrorBorder" Color="#4A2F2E" />

    <!-- ── Pausen-Overlay ──────────────────────────────────────────────────────
         Bewusst dieselben Werte wie in der hellen Belegung — Begründung dort. -->
    <SolidColorBrush x:Key="RcOverlayBackground" Color="#0F1115" />
    <SolidColorBrush x:Key="RcOverlayForeground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="RcOverlayForegroundMuted" Color="#E5E7EB" />
    <SolidColorBrush x:Key="RcOverlayForegroundFaint" Color="#9CA3AF" />

    <!--
        Zweiter Satz für helle Overlay-Farben. Welcher der beiden greift, entscheidet
        das Kontrastverhältnis zur gewählten Farbe, nicht das Erscheinungsbild der
        Fenster — deshalb stehen beide Sätze in beiden Belegungen mit denselben Werten.
    -->
    <SolidColorBrush x:Key="RcOverlayForegroundOnLight" Color="#0B1F1C" />
    <SolidColorBrush x:Key="RcOverlayForegroundMutedOnLight" Color="#334A45" />
    <SolidColorBrush x:Key="RcOverlayForegroundFaintOnLight" Color="#52706A" />

    <!-- ── WinUI-Systempinsel ──────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="#0F1923" />
    <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#152030" />
    <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="#152030" />
    <SolidColorBrush x:Key="NavigationViewContentBackground" Color="#0F1923" />
    <SolidColorBrush x:Key="NavigationViewItemForeground" Color="#E4EDF2" />
    <SolidColorBrush x:Key="NavigationViewItemForegroundPointerOver" Color="#E4EDF2" />
    <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="#DDE5E9" />
    <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPointerOver" Color="#DDE5E9" />
    <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPressed" Color="#DDE5E9" />
    <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="#1A2535" />
    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#22303F" />
    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="#2A3849" />
    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPressed" Color="#2A3849" />
    <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="#C5D0D6" />

    <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#152030" />
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#152030" />
    <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#1A2535" />
    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#1A2535" />
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#22303F" />
    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#2A3849" />

    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#C5D0D6" />
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#DDE5E9" />
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#94A3AB" />
    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#0F1923" />
    <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#22303F" />

    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#E4EDF2" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#8AA3B0" />
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#75909E" />

    <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#33424F" />

    <!-- ── Akzentfarbe des Rahmenwerks ─────────────────────────────────────────
         Begründung siehe Light.xaml. Im Dunklen trägt das Stahlgrau, und die
         Zeichen darauf werden dunkel — sonst stünde Weiß auf Hellgrau. -->
    <Color x:Key="SystemAccentColor">#C5D0D6</Color>
    <Color x:Key="SystemAccentColorLight1">#DDE5E9</Color>
    <Color x:Key="SystemAccentColorLight2">#E8EEF1</Color>
    <Color x:Key="SystemAccentColorLight3">#F2F6F8</Color>
    <Color x:Key="SystemAccentColorDark1">#94A3AB</Color>
    <Color x:Key="SystemAccentColorDark2">#75868F</Color>
    <Color x:Key="SystemAccentColorDark3">#586A73</Color>

    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="#C5D0D6" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="#DDE5E9" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed" Color="#94A3AB" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeChecked" Color="#C5D0D6" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPointerOver" Color="#DDE5E9" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPressed" Color="#94A3AB" />
    <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="#0F1923" />
    <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" Color="#0F1923" />
    <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPressed" Color="#0F1923" />

    <SolidColorBrush x:Key="HyperlinkButtonForeground" Color="#C5D0D6" />
    <SolidColorBrush x:Key="HyperlinkButtonForegroundPointerOver" Color="#DDE5E9" />
    <SolidColorBrush x:Key="HyperlinkButtonForegroundPressed" Color="#94A3AB" />

    <SolidColorBrush x:Key="SliderTrackValueFill" Color="#C5D0D6" />
    <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#DDE5E9" />
    <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#94A3AB" />
    <SolidColorBrush x:Key="SliderThumbBackground" Color="#C5D0D6" />
    <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#DDE5E9" />
    <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#94A3AB" />

    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#C5D0D6" />
    <SolidColorBrush x:Key="TextControlSelectionHighlightColor" Color="#3A5A6E" />
    <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="#22303F" />
    <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPointerOver" Color="#2A3849" />

</ResourceDictionary>
