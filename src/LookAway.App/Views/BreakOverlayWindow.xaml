<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="LookAway.Views.BreakOverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- Abgedunkelter Vollbild-Hintergrund; helle Schrift fuer den Pausen-Inhalt.
         Die konkrete Hintergrundfarbe setzt der Code-Behind aus den Einstellungen. -->
    <Grid x:Name="RootGrid" Background="#F20F1115">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Escape" Invoked="OnEscapeInvoked" />
        </Grid.KeyboardAccelerators>

        <StackPanel
            VerticalAlignment="Center"
            HorizontalAlignment="Center"
            MaxWidth="960"
            Spacing="20">

            <TextBlock
                x:Name="TitleText"
                HorizontalAlignment="Center"
                TextAlignment="Center"
                FontSize="40"
                FontWeight="SemiBold"
                AutomationProperties.LiveSetting="Assertive"
                Foreground="#FFFFFFFF" />

            <TextBlock
                x:Name="HintText"
                HorizontalAlignment="Center"
                TextAlignment="Center"
                FontSize="22"
                Foreground="#FFE5E7EB" />

            <TextBlock
                x:Name="CountdownText"
                HorizontalAlignment="Center"
                TextAlignment="Center"
                FontSize="76"
                FontWeight="Bold"
                Foreground="#FFFFFFFF" />

            <TextBlock
                x:Name="EndHintText"
                HorizontalAlignment="Center"
                TextAlignment="Center"
                FontSize="14"
                Margin="0,24,0,0"
                Foreground="#FF9CA3AF" />
        </StackPanel>
    </Grid>
</Window>
