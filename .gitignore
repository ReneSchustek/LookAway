# ============================================================
# .gitignore – PostManager
# ============================================================
# Hinweis: interne Arbeitsdateien, STATUS.md, DEPLOYMENT.md,
# zugaenge.md usw. sind in ~/.gitignore_global eingetragen
# und müssen hier NICHT wiederholt werden.
# ============================================================

# ============================================================
# ============================================================
.gitignore-template

# ============================================================
# SCRIPTE nie committen — Ausnahme: tools/ liefert Repo-Skripte
# ============================================================
*.ps1
!tools/*.ps1

# ============================================================
# Hinweis: reviews/ gehört NICHT in .gitignore
# ============================================================
# reviews/ wird auf DevBox in Git versioniert (Entwicklungshistorie).
# GitHub-Export-Script schließt reviews/ automatisch aus.
# Niemals reviews/ hier eintragen.
# ============================================================

# ============================================================
# Secrets / Umgebungsvariablen (NIEMALS in Git!)
# ============================================================
.env
.env.local
.env.*.local
!.env.example
secrets.json
*.pfx
*.p12
*.key
config/secrets/

# ============================================================
# Logs
# ============================================================
*.log
/logs/

# ============================================================
# .NET / Visual Studio
# ============================================================
bin/
obj/
*.user
*.suo
*.userosscache
*.sln.docstates
.vs/
packages/
*.nupkg
project.lock.json
*.nuget.props
*.nuget.targets

# Build-Ergebnisse
[Dd]ebug/
[Rr]elease/
x64/
x86/
ARM64/
[Bb]uild/
bld/

# Publish
publish/

# NuGet
**/[Pp]ackages/*
!**/[Pp]ackages/build/

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Rider
.idea/
